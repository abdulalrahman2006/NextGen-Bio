NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# The public address of the site. Used for link previews. Change it when the site goes online.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase → Project Settings → API → "service_role" key (NOT the anon key). This one is secret:
# it bypasses every security rule in the database. Only used for admin "Delete account". Never
# put NEXT_PUBLIC_ in front of this name, never commit it, never show it to anyone.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
